---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import ContactForm from './ContactForm.astro';
import Timeline from './Timeline.astro';
import { awards, contactIconPath, educationItems, experienceItems, publicationGroups, socialLinks } from '../data/portfolio';
import { translations } from '../i18n/translations';
import type { Locale } from '../i18n/types';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang];
const profileImageSrc = `${import.meta.env.BASE_URL}/top_picture.jpg`;
---

<Layout title={t.meta.title} description={t.meta.description} lang={lang}>
  <Navbar lang={lang} />

  <main class="pt-16">
    <section id="hero" class="min-h-screen flex items-center justify-center pt-16 pb-12">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <img
          src={profileImageSrc}
          alt={t.hero.profileAlt}
          class="w-32 h-32 rounded-full mx-auto mb-8 object-cover block"
        />
        <h1 class="text-4xl md:text-6xl font-semibold mb-4 leading-tight">
          <span class="text-blue-600">{t.hero.name}</span>
        </h1>
        <p class="text-xl text-gray-700 mb-4">{t.hero.role}</p>
        <div class="flex items-center justify-center gap-4 mb-8 flex-wrap">
          <a href="#contact"
            class="px-8 py-3 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition-colors shadow-sm">
            {t.hero.contact}
          </a>
        </div>
        <div class="flex items-center justify-center gap-6 text-gray-600">
          {socialLinks.map(link => (
            <a href={link.href} target="_blank" rel="noreferrer"
              class="hover:text-blue-600 transition-colors" aria-label={link.label}>
              <svg class={link.iconClass ?? 'w-6 h-6'} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={link.iconPath} />
              </svg>
            </a>
          ))}
          <a href="#contact" class="hover:text-blue-600 transition-colors" aria-label={t.hero.contactAriaLabel}>
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d={contactIconPath} />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section id="about" class="py-20 bg-white">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="text-4xl text-center font-semibold mb-12">{t.about.heading}</h2>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <img
            src={profileImageSrc}
            alt={t.hero.profileAlt}
            class="aspect-square w-full rounded-2xl card-shadow object-cover"
            loading="lazy"
          />
          <div>
            <h3 class="text-2xl font-semibold mb-4">{t.about.title}</h3>
            <p class="text-gray-600 mb-4 leading-relaxed">{t.about.paragraphs[0]}</p>
            <p class="text-gray-600 mb-6 leading-relaxed">{t.about.paragraphs[1]}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="education" class="py-20 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-4xl text-center font-semibold mb-4">{t.sections.education}</h2>
        <Timeline items={educationItems} lang={lang} />
      </div>
    </section>

    <section id="experience" class="py-20 bg-white">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-4xl text-center font-semibold mb-4">{t.sections.experience}</h2>
        <Timeline items={experienceItems} lang={lang} />
      </div>
    </section>

    <section id="research" class="py-20 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="text-4xl text-center font-semibold mb-4">{t.sections.research}</h2>
        <div class="space-y-10 mt-12">
          {publicationGroups.map(group => (
            <div>
              <div class="mb-5">
                <p class="text-sm font-semibold uppercase tracking-wider text-blue-600">{group.name}</p>
                <h3 class="text-2xl font-semibold mt-1">{group.venue}</h3>
                <p class="text-gray-500 text-sm mt-1">{group.meta[lang]}</p>
              </div>
              <div class="grid gap-4">
                {group.publications.map(publication => (
                  <article class="rounded-lg border border-gray-200 bg-white p-5 card-shadow">
                    <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                      <div>
                        <h4 class="text-xl font-semibold leading-snug">
                          <a href={publication.url} target="_blank" rel="noreferrer"
                            class="text-gray-900 hover:text-blue-600 transition-colors">
                            {publication.title}
                          </a>
                        </h4>
                        <p class="text-gray-600 text-sm mt-3 leading-relaxed">
                          {publication.authors.map((author, index) => (
                            <Fragment>
                              <span class:list={[author === 'Yuhei Yamada' && 'font-semibold text-gray-900']}>{author}</span>{index < publication.authors.length - 1 ? ', ' : ''}
                            </Fragment>
                          ))}
                        </p>
                        <p class="text-gray-500 text-sm mt-2">{publication.pages}</p>
                      </div>
                      <div class="flex items-center gap-2 shrink-0">
                        <span class={publication.isFirstAuthor
                          ? 'inline-flex rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700'
                          : 'inline-flex rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600'}>
                          {publication.role[lang]}
                        </span>
                        <a href={publication.url} target="_blank" rel="noreferrer"
                          class="inline-flex rounded-full border border-blue-600 px-3 py-1 text-xs font-semibold text-blue-600 hover:bg-blue-50 transition-colors">
                          IEEE Xplore
                        </a>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="awards" class="py-20 bg-white">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-4xl text-center font-semibold mb-4">{t.sections.awards}</h2>
        <Timeline items={awards} lang={lang} />
      </div>
    </section>

    <section id="contact" class="py-20 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="text-4xl text-center font-semibold mb-4">{t.sections.contact}</h2>
        <p class="text-center text-gray-600 mb-12">{t.contact.introduction}</p>
        <div class="md:flex md:justify-center">
          <div class="w-full md:w-1/2">
            <ContactForm lang={lang} />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
